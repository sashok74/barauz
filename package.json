{
  "name": "erp-ui-renderer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Schema-driven UI renderer for ERP systems",
  "scripts": {
    "scaffold": "tsx tools/scaffold.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "schema:validate": "tsx tools/schema-check.ts",
    "schema:gen-types": "json2ts ./packages/schemas/*.json -o ./packages/schema-types/index.d.ts",
    "msw": "tsx src/data/msw/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --reporter=list",
    "e2e:ui": "playwright test --ui",
    "ci:all": "npm run typecheck && npm run lint && npm run format && npm run build && npm run schema:validate && npm run test && npm run e2e"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@mui/x-date-pickers": "^7.22.2",
    "@tanstack/react-query": "^5.62.7",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dayjs": "^1.11.13",
    "i18next": "^23.16.5",
    "json-logic-js": "^2.0.5",
    "pdfmake": "^0.2.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "vis-timeline": "^7.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@faker-js/faker": "^9.2.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/json-logic-js": "^2.0.7",
    "@types/node": "^22.9.3",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "json-schema-to-typescript": "^15.0.3",
    "jsdom": "^25.0.1",
    "msw": "^2.6.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
